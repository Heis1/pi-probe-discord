[Unit]
Description=Pi Probe Discord SNMP UDP listener
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/pi-probe-discord
Environment=MPLCONFIGDIR=/var/lib/pi-probe-discord/.config/matplotlib
ExecStart=/usr/bin/pi-probe-discord router-listener
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
