[Unit]
Description=Pi Probe Discord SNMP UDP listener
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/pi-probe-discord
ExecStart=/opt/pi-probe-discord/.venv/bin/python /opt/pi-probe-discord/pihole_update_report.py router-listener
Restart=always
RestartSec=2
