# Copy this file to `pihole-update-discord.env` and set a real webhook URL.
# Both scripts will also accept WEBHOOK_URL from the environment.

WEBHOOK_URL="https://discord.com/api/webhooks/replace/this"
# Set false to prevent every scheduled report and firewall alert from posting to Discord.
PI_PROBE_DISCORD_REPORTING_ENABLED="true"
# Comma-separated report modes that may post. For hourly speed reports only:
# PI_PROBE_DISCORD_REPORT_MODES="speedtest-only"

# Optional overrides:
# DB_PATH="/var/lib/pi-probe-discord/pi_probe_discord.db"
# CHART_FILE="/var/lib/pi-probe-discord/speed_chart.png"
# PI_PROBE_FIREWALL_CHART_FILE="/var/lib/pi-probe-discord/firewall_snapshot.png"
# PI_PROBE_DASHBOARD_STYLE="standard"
# PI_PROBE_INTERACTIVE_DASHBOARD_ENABLED="false"
# PI_PROBE_INTERACTIVE_DASHBOARD_FILE="/var/lib/pi-probe-discord/dashboard/index.html"
# PI_PROBE_INTERACTIVE_DASHBOARD_HOST="127.0.0.1"
# PI_PROBE_INTERACTIVE_DASHBOARD_PORT="8088"
# PI_PROBE_INTERACTIVE_DASHBOARD_TLS_ENABLED="false"
# PI_PROBE_INTERACTIVE_DASHBOARD_TLS_CERT_FILE="/etc/pi-probe-discord/dashboard-cert.pem"
# PI_PROBE_INTERACTIVE_DASHBOARD_TLS_KEY_FILE="/etc/pi-probe-discord/dashboard-key.pem"
# PI_PROBE_INTERACTIVE_DASHBOARD_API_TOKEN=""
# PI_PROBE_DASHBOARD_REFRESH_SECONDS="60"
# PI_PROBE_PUBLIC_DASHBOARD_URL="https://example.com/pi-probe/"
# PI_PROBE_DASHBOARD_LINK_LABEL="Open Interactive Dashboard"
# PI_PROBE_OUTAGE_DOWNLOAD_MBPS="50"
# PI_PROBE_DEGRADED_DOWNLOAD_MBPS="250"
# PI_PROBE_HIGH_PING_MS="20"
# PI_PROBE_FAILED_TEST_IS_OUTAGE="true"
# PI_PROBE_HEATMAP_GOOD_MBPS="320"
# PI_PROBE_HEATMAP_WARN_MBPS="250"
# PI_PROBE_ROUTER_EVENTS_CSV="/var/lib/pi-probe-discord/events/router_events.csv"
# PI_PROBE_ROUTER_EVENTS_JSON="/var/lib/pi-probe-discord/events/router_events.json"
# PI_PROBE_PIHOLE_HOURLY_CSV="/var/lib/pi-probe-discord/pihole/pihole_hourly.csv"
# HISTORY_RETENTION_DAYS="365"
# MAX_TEXT_FIELD_LENGTH="1200"
# REQUEST_TIMEOUT="30"
# SPEEDTEST_SCHEDULE_MINUTES="60"  # Minimum 30 minutes; use a systemd override only when intentionally changing this.
# FULL_REPORT_SCHEDULE="03:30"
# PI_PROBE_FIREWALL_ENABLED="true"
# PI_PROBE_FIREWALL_WINDOW_HOURS="24"
# PI_PROBE_FIREWALL_TOP_N="5"
# PI_PROBE_FIREWALL_NOISY_SOURCE_THRESHOLD="10"
# PI_PROBE_FIREWALL_INCLUDE_ALLOW="false"
# PI_PROBE_FIREWALL_LOG_PATHS="/var/log/ufw.log,/var/log/kern.log,/var/log/syslog"
# PI_PROBE_FIREWALL_ALERT_ENABLED="true"
# PI_PROBE_FIREWALL_ALERT_MIN_BLOCKS="80"
# PI_PROBE_FIREWALL_ALERT_MIN_SSH_ATTEMPTS="20"
# PI_PROBE_FIREWALL_ALERT_MIN_NOISY_SOURCES="2"
# PI_PROBE_FIREWALL_ALERT_COOLDOWN_MINUTES="60"
# PI_PROBE_FIREWALL_ALERT_STATE_FILE="/var/lib/pi-probe-discord/firewall_alert_state.json"
# PI_PROBE_ROUTER_SNMP_ENABLED="false"
# PI_PROBE_ROUTER_SNMP_LOG_PATH="/var/log/snmptrapd.log"
# PI_PROBE_ROUTER_SNMP_STATE_FILE="/var/lib/pi-probe-discord/router_snmp_ingest_state.json"
# PI_PROBE_ROUTER_SNMP_WINDOW_HOURS="24"
# PI_PROBE_ROUTER_SNMP_TOP_N="5"
# PI_PROBE_ROUTER_SNMP_LISTENER_ENABLED="false"
# PI_PROBE_ROUTER_SNMP_BIND_HOST="127.0.0.1"
# PI_PROBE_ROUTER_SNMP_BIND_PORT="9162"
# PI_PROBE_ROUTER_SNMP_MAX_EVENTS_PER_MINUTE="120"
# PI_PROBE_ROUTER_SNMP_MAX_PACKET_BYTES="4096"
# PI_PROBE_ROUTER_SNMP_OID_SEVERITY_MAP="SNMPv2-MIB::authenticationFailure=critical,IF-MIB::linkDown=warning,SNMPv2-MIB::coldStart=warning"
# PI_PROBE_TOPOLOGY_ENABLED="false"
# PI_PROBE_TOPOLOGY_NODES_JSON='[{"id":"router","name":"Main Router","host":"192.168.1.1","management_ip":"192.168.1.1","community":"public","role":"router"},{"id":"access-point","name":"Access Point","host":"192.168.1.2","management_ip":"192.168.1.2","community":"public","role":"access_point"}]'
# PI_PROBE_TOPOLOGY_CACHE_JSON="/var/lib/pi-probe-discord/topology/latest.json"
# PI_PROBE_TOPOLOGY_REFRESH_MINUTES="30"
# PI_PROBE_TOPOLOGY_SNMPWALK_BIN="snmpwalk"
# PI_PROBE_TOPOLOGY_SNMP_TIMEOUT_SECONDS="6"
# PI_PROBE_ROUTER_WEBUI_ENABLED="false"
# PI_PROBE_ROUTER_WEBUI_URL="http://192.168.1.1"
# PI_PROBE_ROUTER_WEBUI_SECRET_FILE="/etc/pi-probe-discord/router-webui.env"
# PI_PROBE_ROUTER_WEBUI_CA_FILE="/etc/pi-probe-discord/router-webui-ca.pem"
# PI_PROBE_NMAP_SCAN_MINUTES="360"
# PI_PROBE_NMAP_TARGETS="192.168.1.0/24 10.10.10.0/24"
# PI_PROBE_KEEPALIVE_ENABLED="true"
# PI_PROBE_KEEPALIVE_DEVICES_JSON='[{"name":"FortiWiFi 30E","host":"10.10.10.1","role":"firewall"},{"name":"AX1800","host":"10.10.10.2","role":"access_point"},{"name":"FortiAP-U431F","host":"10.10.10.105","role":"access_point"}]'
# PI_PROBE_KEEPALIVE_STATE_JSON="/var/lib/pi-probe-discord/keepalive/latest.json"
# PI_PROBE_KEEPALIVE_TIMEOUT_SECONDS="2"
# PI_PROBE_FORTIGATE_ENABLED="false"
# FORTIGATE_BASE_URL="https://10.10.10.1"
# FORTIGATE_API_TOKEN is read from the protected fortigate.env file or the service environment; never put it here.
# PI_PROBE_FORTIGATE_VDOM="root"
# PI_PROBE_FORTIGATE_SECRET_FILE="/etc/pi-probe-discord/fortigate.env"
# PI_PROBE_FORTIGATE_CA_FILE="/etc/pi-probe-discord/fortigate-ca.pem"
# PI_PROBE_FORTIGATE_STATE_JSON="/var/lib/pi-probe-discord/fortigate/latest.json"
# PI_PROBE_FORTIGATE_TIMEOUT_SECONDS="8"
# FORTIGATE_TLS_VERIFY="true"
# PI_PROBE_SMTP_LOG_ENABLED="true"
# PI_PROBE_SMTP_LOG_BIND_HOST="0.0.0.0"
# PI_PROBE_SMTP_LOG_PORT="25"
# PI_PROBE_SMTP_LOG_DIRECTORY="/var/lib/pi-probe-discord/router-mail"
# PI_PROBE_DISCORD_REPORT_CHANNEL_ID="123456789012345678"
