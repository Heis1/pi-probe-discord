# Root-only router UI credentials for optional local scraping.
# Suggested install path: /etc/pi-probe-discord/router-webui.env
# Required permissions:
#   sudo chown root:root /etc/pi-probe-discord/router-webui.env
#   sudo chmod 600 /etc/pi-probe-discord/router-webui.env

PI_PROBE_ROUTER_WEBUI_USERNAME="admin"
PI_PROBE_ROUTER_WEBUI_PASSWORD="replace-this"
