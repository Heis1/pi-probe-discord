[Unit]
Description=Pi Probe Discord interactive dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/pi-probe-discord
Environment=MPLCONFIGDIR=/var/lib/pi-probe-discord/.config/matplotlib
ExecStart=/usr/bin/pi-probe-discord dashboard-serve
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
