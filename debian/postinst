#!/bin/sh
set -e

SERVICE_USER="pi-probe-discord"
SERVICE_GROUP="pi-probe-discord"

ensure_service_account() {
    if ! getent group "$SERVICE_GROUP" >/dev/null 2>&1; then
        addgroup --system "$SERVICE_GROUP" >/dev/null 2>&1 || true
    fi
    if ! id -u "$SERVICE_USER" >/dev/null 2>&1; then
        adduser \
            --system \
            --ingroup "$SERVICE_GROUP" \
            --home /var/lib/pi-probe-discord \
            --no-create-home \
            --disabled-login \
            --disabled-password \
            "$SERVICE_USER" >/dev/null 2>&1 || true
    fi
}

ensure_service_account

mkdir -p /etc/pi-probe-discord
mkdir -p /var/lib/pi-probe-discord
chown root:"$SERVICE_GROUP" /var/lib/pi-probe-discord || true
chmod 2770 /var/lib/pi-probe-discord || true

if [ ! -f /etc/pi-probe-discord/pihole-update-discord.env ]; then
    install -m 600 /usr/share/pi-probe-discord/pihole-update-discord.env.example /etc/pi-probe-discord/pihole-update-discord.env
fi

if [ ! -f /etc/pi-probe-discord/pi-probe-discord-bot.env ]; then
    install -m 600 /usr/share/pi-probe-discord/pi-probe-discord-bot.env.example /etc/pi-probe-discord/pi-probe-discord-bot.env
fi

chown root:"$SERVICE_GROUP" /etc/pi-probe-discord/pihole-update-discord.env || true
chown root:"$SERVICE_GROUP" /etc/pi-probe-discord/pi-probe-discord-bot.env || true
chmod 640 /etc/pi-probe-discord/pihole-update-discord.env || true
chmod 640 /etc/pi-probe-discord/pi-probe-discord-bot.env || true

if [ -d /var/lib/pi-probe-discord/dashboard ]; then
    chown -R root:"$SERVICE_GROUP" /var/lib/pi-probe-discord/dashboard || true
fi
if [ -f /var/lib/pi-probe-discord/pihole-update-discord.log ]; then
    chown root:"$SERVICE_GROUP" /var/lib/pi-probe-discord/pihole-update-discord.log || true
    chmod 640 /var/lib/pi-probe-discord/pihole-update-discord.log || true
fi
if [ -f /var/lib/pi-probe-discord/speed_chart.png ]; then
    chown root:"$SERVICE_GROUP" /var/lib/pi-probe-discord/speed_chart.png || true
    chmod 640 /var/lib/pi-probe-discord/speed_chart.png || true
fi
if [ -f /var/lib/pi-probe-discord/firewall_snapshot.png ]; then
    chown root:"$SERVICE_GROUP" /var/lib/pi-probe-discord/firewall_snapshot.png || true
    chmod 640 /var/lib/pi-probe-discord/firewall_snapshot.png || true
fi

restart_if_enabled() {
    unit="$1"
    if command -v systemctl >/dev/null 2>&1; then
        if systemctl is-enabled "$unit" >/dev/null 2>&1 || systemctl is-active "$unit" >/dev/null 2>&1; then
            systemctl restart "$unit" || true
        fi
    fi
}

if command -v systemctl >/dev/null 2>&1; then
    systemctl daemon-reload || true
    restart_if_enabled pi-probe-discord-speedtest.timer
    restart_if_enabled pi-probe-discord-full.timer
    restart_if_enabled pi-probe-discord-bot.service
    restart_if_enabled pi-probe-discord-dashboard.service
    restart_if_enabled pi-probe-discord-snmp-listener.service
fi

echo "pi-probe-discord installed."
echo "Next step: run sudo pi-probe-discord-install if webhook, schedules, or paths need changing."
echo ""
echo "Health check:"
echo "  sudo pi-probe-discord doctor"

exit 0
