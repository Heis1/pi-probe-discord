[Unit]
Description=Pi Probe Discord FortiWiFi syslog receiver
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/pi-probe-discord
ExecStart=/usr/bin/pi-probe-discord fortigate-syslog-listener
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
