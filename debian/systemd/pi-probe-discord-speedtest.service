[Unit]
Description=Pi Probe Discord periodic speed test
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/pi-probe-discord
Environment=MPLCONFIGDIR=/var/lib/pi-probe-discord/.config/matplotlib
# The native Ookla client requires HOME for its config and license state.
Environment=HOME=/var/lib/pi-probe-discord
ExecStart=/usr/bin/pi-probe-discord speedtest-only
