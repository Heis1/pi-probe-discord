# Read-only FortiGate REST API token. Install as /etc/pi-probe-discord/fortigate.env.
# Ownership and mode must be root:root and 600.
PI_PROBE_FORTIGATE_API_TOKEN="replace-with-read-only-api-token"
# Optional SNMPv3 authPriv credentials. Keep this file root:root, mode 600.
# PI_PROBE_FORTIGATE_SNMP_USERNAME="pi_probe"
# PI_PROBE_FORTIGATE_SNMP_AUTH_PROTOCOL="SHA-256"
# PI_PROBE_FORTIGATE_SNMP_AUTH_PASSWORD="replace-with-auth-secret"
# PI_PROBE_FORTIGATE_SNMP_PRIVACY_PROTOCOL="AES-256"
# PI_PROBE_FORTIGATE_SNMP_PRIVACY_PASSWORD="replace-with-privacy-secret"
# PI_PROBE_FORTIGATE_30E_SNMP_USERNAME="pi_probe"
# PI_PROBE_FORTIGATE_30E_SNMP_AUTH_PROTOCOL="SHA-256"
# PI_PROBE_FORTIGATE_30E_SNMP_AUTH_PASSWORD="replace-with-auth-secret"
# PI_PROBE_FORTIGATE_30E_SNMP_PRIVACY_PROTOCOL="AES-128"
# PI_PROBE_FORTIGATE_30E_SNMP_PRIVACY_PASSWORD="replace-with-privacy-secret"
