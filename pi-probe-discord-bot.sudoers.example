# Install with:
#   sudo visudo -f /etc/sudoers.d/pi-probe-discord-bot
#
# Replace "pi-probe-discord" only if you intentionally run the bot under a different Linux user.

pi-probe-discord ALL=(root) NOPASSWD: /bin/systemctl start --no-block pi-probe-discord-speedtest.service
pi-probe-discord ALL=(root) NOPASSWD: /bin/systemctl start pi-probe-discord-speedtest.service
pi-probe-discord ALL=(root) NOPASSWD: /bin/systemctl start --no-block pi-probe-discord-full.service
pi-probe-discord ALL=(root) NOPASSWD: /bin/systemctl start pi-probe-discord-full.service
pi-probe-discord ALL=(root) NOPASSWD: /usr/bin/pi-probe-discord firewall
pi-probe-discord ALL=(root) NOPASSWD: /usr/bin/pi-probe-discord firewall-chart
pi-probe-discord ALL=(root) NOPASSWD: /usr/bin/pi-probe-discord router
pi-probe-discord ALL=(root) NOPASSWD: /usr/sbin/ufw status verbose
# Optional if logs are only available via journald:
pi-probe-discord ALL=(root) NOPASSWD: /usr/bin/journalctl -k --since -24 hours --no-pager
